@model _25DH110874_MyStore.Models.ViewModel.HomeProductVM
@using PagedList.Mvc

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

@if (Model.NewProducts != null && Model.NewProducts.Any())
{
    <section class="container-fluid newProd">
        <h2>New Products</h2>
        <div class="row">
            @foreach (var product in Model.NewProducts)
            {
                <div>
                    <a href="@Url.Action("ProductDetail", "Home", new {id = product.ProductID})">
                        <img src="@Html.DisplayFor(p => product.ProductImage)" alt="@product.ProductName" />
                    </a>
                </div>
                <div class="col-md-4">
                    <div class="product-card">
                        <h3>@product.ProductName</h3>
                        <p>@product.ProductDescription</p>
                        <p class="price">$@product.ProductPrice.ToString("F2")</p>
                        <a href="@Url.Action("Details", "Product", new { id = product.ProductID })" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            }
        </div>
        <div class="pagination-container">
            @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm }))
        </div>
    </section>
}
else
{
    <p>No new products available.</p>
}